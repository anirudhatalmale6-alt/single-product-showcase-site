# Copy this file to `.env` and fill it in. NEVER commit `.env` to git.

# --- Server ------------------------------------------------------------------
PORT=3000
NODE_ENV=production
# The public address of the site. Used to build Stripe's return URLs, so it
# must match what customers actually see in the address bar.
PUBLIC_URL=https://your-domain.com

# --- Stripe ------------------------------------------------------------------
# Leave these blank and the site runs in demo mode: the order -> confirmation
# -> email path works, but no payment is taken and no card field is shown.
#
# Test keys start sk_test_ / whsec_ . Live keys start sk_live_ .
# Get them from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From https://dashboard.stripe.com/webhooks after you add an endpoint
# pointing at  https://your-domain.com/webhook/stripe
# subscribed to the event  checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Comma-separated ISO country codes you will ship to.
SHIPPING_COUNTRIES=US,CA,GB,AU,NZ,IE,DE,FR,ES,IT,NL,SE,NO,DK,FI,IN,AE,SG

# --- Email -------------------------------------------------------------------
# Leave SMTP_HOST blank and confirmation emails are written to
# data/emails/<ref>.eml instead of being sent - useful while testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ALCHEMY & CO. <orders@your-domain.com>"
